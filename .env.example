# JARVIS Environment Configuration

# General
PROJECT_NAME=JARVIS
ENVIRONMENT=development
LOG_LEVEL=INFO

# Infrastructure Ports
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
NATS_PORT=4222
OLLAMA_PORT=11434

# Infrastructure Credentials (Change in production)
POSTGRES_USER=jarvis_admin
POSTGRES_PASSWORD=jarvis_secure_pass
POSTGRES_DB=jarvis_db

# Backend
API_PORT=8000
API_HOST=127.0.0.1

# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_JETSTREAM_ENABLED=true

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
