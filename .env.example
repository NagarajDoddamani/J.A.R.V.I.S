# JARVIS Environment Configuration
# Aligned with JDOS v1.2 (Corrections 5, 7, 8, 10)

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
PROJECT_NAME=JARVIS
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Infrastructure Ports
# ---------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
NATS_PORT=4222
OLLAMA_PORT=11434

# ---------------------------------------------------------------------------
# Infrastructure Credentials (Change in production)
# ---------------------------------------------------------------------------
POSTGRES_USER=jarvis_admin
POSTGRES_PASSWORD=jarvis_secure_pass
POSTGRES_DB=jarvis_db

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
API_PORT=8000
API_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# NATS Configuration (JDOS v1.2, Correction 10)
# ---------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
NATS_JETSTREAM_ENABLED=true

# Wire-level boundaries. The 256 KiB limit is governance-locked; override
# only via ADR.
NATS_MAX_PAYLOAD_BYTES=262144
NATS_PAYLOAD_HEADROOM_BYTES=1024
NATS_RETRY_ATTEMPTS=5
NATS_RETRY_BASE_MS=250
NATS_RETRY_MAX_BACKOFF_MS=30000
NATS_ACK_WAIT_SECONDS=30
NATS_MAX_ACK_PENDING=1000
NATS_DUPLICATE_WINDOW_SECONDS=120
NATS_EVENTS_RETENTION_SECONDS=2592000
NATS_AUDIT_SIGNALS_BUFFER_SECONDS=604800
NATS_STREAM_STORAGE=file
NATS_STREAM_REPLICAS=1
NATS_AUTO_BOOTSTRAP=true

# ---------------------------------------------------------------------------
# PostgreSQL Service Roles (JDOS v1.2, Corrections 7 & 8)
# ---------------------------------------------------------------------------
POSTGRES_ROLE_ORCHESTRATION=jarvis_orchestration_app
POSTGRES_ROLE_MEMORY=jarvis_memory_app
POSTGRES_ROLE_KNOWLEDGE=jarvis_knowledge_app
POSTGRES_ROLE_NOTIFICATION=jarvis_notification_app
POSTGRES_ROLE_SETTINGS=jarvis_settings_app
POSTGRES_ROLE_AUDIT=jarvis_audit_app

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
